{
  "expo": {
    "name": "layer-app",
    "slug": "layer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/justice_scales_logo.jpg",
    "scheme": "layerapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.firm.layerapp",
      "adaptiveIcon": {
        "backgroundColor": "#0A192F",
        "foregroundImage": "./assets/images/justice_scales_logo.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A192F",
          "image": "./assets/images/justice_scales_logo.jpg",
          "imageWidth": 120
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
